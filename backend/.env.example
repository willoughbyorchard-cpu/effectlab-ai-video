# Optional legacy provider mode only. Leave FAL_KEY unset to use the custom Scratch model.
# If used, set the real key only in a host secret manager, never in GitHub.
FAL_KEY=replace_with_your_fal_api_key
EFFECTLAB_FAL_MODEL=fal-ai/pixverse/swap
EFFECTLAB_ALLOWED_ORIGINS=https://willoughbyorchard-cpu.github.io
EFFECTLAB_MAX_VIDEO_SECONDS=8

# Optional public cloud deployment (never commit the real token).
EFFECTLAB_CLOUD_MODE=1
EFFECTLAB_ACCESS_TOKEN=replace_with_a_long_random_secret
EFFECTLAB_MAX_JOBS_PER_HOUR=2
EFFECTLAB_TORCH_NUM_THREADS=1
